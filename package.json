{
  "name": "dotfiles",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "format": "stylua ."
  },
  "lint-staged": {
    "*.lua": "stylua",
    "{*.nu,!(nushell)/**/*.nu,nushell/{*.nu,!(nu_scripts)/**/*.nu}}": "nufmt",
    "{*.toml,!(nushell)/**/*.toml,nushell/{*.toml,!(nu_scripts)/**/*.toml}}": "oxfmt"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
