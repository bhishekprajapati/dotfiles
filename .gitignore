.claude/
.claude.json
**/opencode/auth*
**/github-copilot/
**/copilot/
**/.codeium/
**/.cursor/
**/.continue/
**/.aider*

# ---------------------------------------------------------------------
# Shell history & session state
# ---------------------------------------------------------------------
*_history
*history.txt
*history.sqlite3*
.histfile
.lesshst
.viminfo
.python_history
.node_repl_history
.wget-hsts
**/zoxide/
**/atuin/
**/nushell/history*
**/fish/fish_variables
**/fish_history

# ---------------------------------------------------------------------
# Neovim / editor runtime state
# ---------------------------------------------------------------------
**/nvim/shada/
**/nvim/swap/
**/nvim/undo/
**/nvim/sessions/
*.shada
Session.vim
.netrwhist
tags
.luarc.local.json

# ---------------------------------------------------------------------
# Runtime / cache / logs / databases
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
node_modules/
.cache/
cache/
*.cache
*.log
logs/
*.pid
*.sock
*.sqlite
*.sqlite3
*.db
*.db-*
tmp/
.tmp/

# ---------------------------------------------------------------------
# Archives & dumps (easy way to leak a whole directory)
# ---------------------------------------------------------------------
*.zip
*.tar
*.tar.*
*.tgz
*.gz
*.7z
*.rar
*.dump
core
core.*
