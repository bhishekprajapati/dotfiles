# =====================================================================
# Public dotfiles — be paranoid. If unsure, it stays out.
# =====================================================================

# ---------------------------------------------------------------------
# Backups / editor & OS leftovers
# ---------------------------------------------------------------------
*.bak
*.bak-*
*.bak.*
*.backup
*.old
*.orig
*.rej
*.tmp
*.temp
*.swp
*.swo
*~
\#*\#
.#*
.DS_Store
Thumbs.db
.directory
.Trash-*

# ---------------------------------------------------------------------
# Env files & generic secret-looking names
# ---------------------------------------------------------------------
.env
.env.*
*.env
.envrc
!.env.example
!*.env.example
*secret*
*Secret*
*SECRET*
*token*
*Token*
*TOKEN*
*credential*
*Credential*
*password*
*passwd*
*apikey*
*api_key*
*api-key*
*.private
*.private.*
private/
secrets/
.secrets/
local.*
*.local
*.local.*

# ---------------------------------------------------------------------
# Keys, certificates, keystores
# ---------------------------------------------------------------------
*.pem
*.key
*.crt
*.cer
*.der
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.gpg
*.pgp
*.asc
*.sig
*.ovpn
*.mobileconfig
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.pub
known_hosts*
authorized_keys*

# ---------------------------------------------------------------------
# Whole config dirs that hold credentials / sessions — never track
# ---------------------------------------------------------------------
**/.ssh/
**/ssh/
**/.gnupg/
**/gnupg/
**/.aws/
**/aws/
**/.azure/
**/gcloud/
**/.kube/
**/kube/
**/.docker/config.json
**/docker/config.json
**/.terraform.d/credentials*
**/gh/hosts.yml
**/hub
**/glab-cli/
**/rclone/rclone.conf
**/keyrings/
**/password-store/
**/.password-store/
**/Bitwarden*/
**/1Password/
**/protonvpn/
**/Proton/
**/wireguard/
**/NetworkManager/system-connections/
**/syncthing/
**/spotify/
**/discord/
**/Slack/
**/BraveSoftware/
**/chromium/
**/google-chrome/
**/mozilla/
**/thunderbird/

